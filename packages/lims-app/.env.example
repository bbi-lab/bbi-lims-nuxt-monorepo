NUXT_SESSION_PASSWORD=
NUXT_PUBLIC_APP_NAME="LIMS app"

# postgres database url
NUXT_DB_HOST=localhost
NUXT_DB_PORT=5432
NUXT_DB_USERNAME=
NUXT_DB_PASSWORD=
NUXT_DB_DATABASE_NAME=
NUXT_DB_SSL=
NUXT_PUBLIC_API_BASE=/api

# jwt secret
NUXT_AUTH_JWT_ACCESS_TOKEN_EXPIRES_IN=5m
NUXT_AUTH_JWT_REFRESH_TOKEN_EXPIRES_IN=60m
NUXT_AUTH_JWT_ACCESS_TOKEN_SECRET=access-token-secret-base64
NUXT_AUTH_JWT_REFRESH_TOKEN_SECRET=refresh-token-secret-base64
