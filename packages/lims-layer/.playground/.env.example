NUXT_SESSION_PASSWORD=
NUXT_PUBLIC_APP_NAME="LIMS layer"

# postgres database url
NUXT_DB_HOST=localhost
NUXT_DB_PORT=5432
NUXT_DB_USERNAME=
NUXT_DB_PASSWORD=
NUXT_DB_DATABASE_NAME=
NUXT_DB_SSL=
NUXT_DB_SSL_CA=
