NUXT_SESSION_PASSWORD=
NUXT_PUBLIC_APP_NAME="LABELseq LIMS"

# postgres database url
NUXT_DB_HOST=localhost
NUXT_DB_PORT=5432
NUXT_DB_USERNAME=
NUXT_DB_PASSWORD=
NUXT_DB_DATABASE_NAME=
NUXT_DB_SSL=
# Set to 'false' to bypass SSL cert validation in local dev only (never in production).
# NUXT_DB_SSL_REJECT_UNAUTHORIZED=false
NUXT_DB_SSL_CA=
NUXT_DB_SSL_CA_PATH=
NUXT_PUBLIC_API_BASE=/api

# jwt secret — REQUIRED. Generate with: openssl rand -base64 64
# Server will refuse to start if these are empty or set to insecure placeholders.
NUXT_AUTH_JWT_ACCESS_TOKEN_EXPIRES_IN=5m
NUXT_AUTH_JWT_REFRESH_TOKEN_EXPIRES_IN=60m
NUXT_AUTH_JWT_ACCESS_TOKEN_SECRET=
NUXT_AUTH_JWT_REFRESH_TOKEN_SECRET=

# smtp config for sending emails
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=
NUXT_PUBLIC_APP_URL=http://localhost:3000
