  "views": {
    "public.view_plates_with_well_counts": {
      "columns": {
        "id": {
          "name": "id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "name": {
          "name": "name",
          "type": "varchar(255)",
          "primaryKey": false,
          "notNull": false
        },
        "size_x": {
          "name": "size_x",
          "type": "smallint",
          "primaryKey": false,
          "notNull": false
        },
        "size_y": {
          "name": "size_y",
          "type": "smallint",
          "primaryKey": false,
          "notNull": false
        },
        "plate_type": {
          "name": "plate_type",
          "type": "varchar",
          "primaryKey": false,
          "notNull": false
        },
        "discarded": {
          "name": "discarded",
          "type": "boolean",
          "primaryKey": false,
          "notNull": false
        },
        "processed": {
          "name": "processed",
          "type": "boolean",
          "primaryKey": false,
          "notNull": false
        },
        "plate_type_label": {
          "name": "plate_type_label",
          "type": "varchar",
          "primaryKey": false,
          "notNull": false
        },
        "wells_count": {
          "name": "wells_count",
          "type": "smallint",
          "primaryKey": false,
          "notNull": false
        },
        "wells_with_content_count": {
          "name": "wells_with_content_count",
          "type": "smallint",
          "primaryKey": false,
          "notNull": false
        },
        "wells_processed_count": {
          "name": "wells_processed_count",
          "type": "smallint",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "with plate_types(plate_type_value, plate_type_label, plate_type_desc) AS (VALUES ('mock-plate-type-1', 'Mock Plate Type 1', 'Mock Plate Type 1'), ('mock-plate-type-2', 'Mock Plate Type 2', 'Mock Plate Type 2')) select\n    \"plates\".\"id\",\n    \"plates\".\"name\",\n    \"plates\".\"size_x\",\n    \"plates\".\"size_y\",\n    \"plates\".\"plate_type\",\n    \"plates\".\"discarded\",\n    \"plates\".\"processed\",\n    (select distinct on (plate_type_value) plate_type_label from plate_types where plate_type_value = \"plates\".\"plate_type\") as plate_type_label,\n    count(distinct(\"wells\".\"id\")) as wells_count,\n    count(distinct(\"well_contents\".\"well_id\")) as wells_with_content_count,\n    count(distinct(\"well_content_sources\".\"source_well_id\")) as wells_processed_count\n    from \"plates\"\n    join \"wells\" on \"plates\".\"id\" = \"wells\".\"plate_id\"\n    left join \"well_content_sources\" on \"wells\".\"id\" = \"well_content_sources\".\"source_well_id\"\n    left join \"well_contents\" on \"wells\".\"id\" = \"well_contents\".\"well_id\"\n    group by \"plates\".\"id\"",
      "name": "view_plates_with_well_counts",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
